#!/bin/sh
# Launcher that lets a Claude Code plugin put `goalpulse` on the agent's PATH (plugin bin/ folder).
if ! command -v node >/dev/null 2>&1; then
  echo "goalpulse needs Node.js 18 or newer (https://nodejs.org). Install it and retry." >&2
  exit 127
fi
exec node "$(dirname "$0")/goalpulse.js" "$@"
